# macOS
.DS_Store

# Editor / tooling local state
.claude/settings.local.json
.idea/
.vscode/

# Internal working files — deliberately not published
CLAUDE.md
docs/TODO.md
docs/phases.md
.claude/agents/chronicler.md
.claude/agents/director.md
briefs/

# Throwaway commit scripts. They carry a deny-list of real names spelled out in
# full — the guard against real names in the repo is itself a file full of them,
# and the first run of one caught exactly that. Local tools, like the vault.
commit-*.sh
scrub-*.sh
catalog-review.py

# The names those scripts hunt for, in one place instead of copied into
# every guard. Never tracked, for the same reason.
.denylist

# Environments and secrets
.env
.env.*
# ...but the EXAMPLE is documentation, not a secret. It names every knob a
# shipped install has and carries no values — a package nobody can configure
# is a package nobody can run.
!.env.example
*.key
*.pem

# Never commit real financial data — the benchmark corpus stays local.
# Match bench-data anywhere (repo root OR bench/bench-data), plus common doc types.
bench-data/
/corpus/
/statements/
*.pdf
*.PDF

# viva-bench live configs (may reference institution names) — examples are committed
bench/corpus.yaml
bench/models.yaml

# Never commit a real ledger vault (encrypted, but still the user's data).
*.vault
product/**/*.jsonl
*.blob
raw-header.json
.viva-vault/
# A run that did not expand `~` writes a real vault into a literal tilde
# directory. Every file in one happens to match a rule above, so nothing was
# committable — a coincidence of which files exist, not containment. Ignore the
# path itself.
~/
product/~/

# The Witness's reports on real-vault runs. Scrubbed when written — no amounts,
# no institution or merchant names, no account fragments, no dates from this
# person's life — because the Steward reads them and commit messages are public.
# Ignored anyway: a scrubbing discipline that is the only thing between a real
# figure and a public repo is one mistake from being wrong.
runs/

# viva-bench local artifacts
bench/.venv/
bench/__pycache__/
bench/**/__pycache__/
bench/.pytest_cache/
bench/*.egg-info/
bench/**/*.egg-info/

# Python build artifacts (any package)
__pycache__/
**/__pycache__/
*.egg-info/
**/*.egg-info/
.pytest_cache/
**/.pytest_cache/
build/
dist/
*.whl
*.tar.gz

# Slice 6.7: the surface source builds to web/static (committed); deps do not ship.
product/viva/web/ui/node_modules/

# Desktop UI dependencies and build output
desktop/node_modules/
desktop/dist/
desktop/*.js
desktop/*.d.ts
desktop/*.tsbuildinfo

# The Cowork device bridge cannot delete files; deletions are parked here for manual removal.
_to_delete/

# merchantcore's SHIPPED seed is committed on purpose — impersonal grammars and
# merchant records that every install starts from. What an installation LEARNS
# is written to ~/.merchantcore (or MERCHANTCORE_HOME), outside any working
# tree, so it cannot be committed by accident rather than merely should not be.
!merchant/merchantcore/data/
!merchant/merchantcore/data/**
